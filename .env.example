# ==============================================================================
# PlanCity - Variables de Entorno de Configuración
# ==============================================================================

# Clave pública de cliente para Google Maps JavaScript API (visible en navegador)
# Restringir en Google Cloud por HTTP Referrer a los dominios autorizados de Vercel y localhost
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Clave privada de servidor para Google Places API (New) (NUNCA exponer en cliente)
# Utilizada exclusivamente por el route handler /api/places/nearby en Next.js
GOOGLE_PLACES_API_KEY=
